# DasBench client configuration for a local vLLM server.
LLM_PROVIDER=custom_chat
CUSTOM_CHAT_API_KEY=local-vllm
CUSTOM_CHAT_API_BASE_URL=http://localhost:8001/v1
CUSTOM_CHAT_MODEL=Qwen2.5-Coder-7B-Instruct
CUSTOM_CHAT_TIMEOUT_SECONDS=14400
CUSTOM_CHAT_MAX_TOKENS=8192
DASBENCH_LLM_WAIT_FOR_IDLE=1
DASBENCH_LLM_IDLE_POLL_SECONDS=5
DASBENCH_LLM_IDLE_MAX_RUNNING_REQUESTS=0
DASBENCH_LLM_IDLE_MAX_WAITING_REQUESTS=0
DASBENCH_CODE_REPAIR_LIMIT=3
DASBENCH_ANALYSIS_RETRY_LIMIT=3
DASBENCH_SOLUTION_REPAIR_LIMIT=3
DASBENCH_SOLVER_TIMEOUT_SECONDS=360
DASBENCH_SOLVER_MEMORY_LIMIT_MB=65536

# Blank this for vLLM unless the specific served model and vLLM version accept it.
CUSTOM_CHAT_REASONING_EFFORT=

# vLLM server configuration consumed by scripts/start_local_vllm.sh.
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
VLLM_SERVED_MODEL_NAME=Qwen2.5-Coder-7B-Instruct
DASBENCH_VLLM_PORT=8001
VLLM_API_KEY=local-vllm
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90
# Optional pass-through args for vLLM. Useful on some multi-GPU hosts.
# VLLM_EXTRA_ARGS="--disable-custom-all-reduce --trust-remote-code --max-num-seqs 512"
