# DasBench client configuration for a local vLLM server.
LLM_PROVIDER=custom_chat
CUSTOM_CHAT_API_KEY=local-vllm
CUSTOM_CHAT_API_BASE_URL=http://localhost:8001/v1
CUSTOM_CHAT_MODEL=Qwen2.5-Coder-7B-Instruct
CUSTOM_CHAT_TIMEOUT_SECONDS=14400

# Leave unset for vLLM unless the specific served model and vLLM version accept it.
# CUSTOM_CHAT_REASONING_EFFORT=

# vLLM server configuration consumed by scripts/start_local_vllm.sh.
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
VLLM_SERVED_MODEL_NAME=Qwen2.5-Coder-7B-Instruct
VLLM_PORT=8001
VLLM_API_KEY=local-vllm
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90
