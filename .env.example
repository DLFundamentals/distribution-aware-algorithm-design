OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.2
OPENAI_REASONING_EFFORT=xhigh
# Optional for OpenAI-compatible endpoints:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional alternate chat provider for local experiments:
# LLM_PROVIDER=custom_chat
# CUSTOM_CHAT_API_KEY=REPLACE_WITH_YOUR_API_KEY
# CUSTOM_CHAT_API_BASE_URL=https://example.com/api
# CUSTOM_CHAT_MODEL=custom-model
# Leave unset for local vLLM unless that server/model supports the field.
# CUSTOM_CHAT_REASONING_EFFORT=xhigh
# CUSTOM_CHAT_TIMEOUT_SECONDS=14400
# CUSTOM_CHAT_MAX_TOKENS=8192
# Optional local-vLLM scheduler: wait for vLLM to be idle before each generation request.
# DASBENCH_LLM_WAIT_FOR_IDLE=1
# DASBENCH_LLM_IDLE_POLL_SECONDS=5
# DASBENCH_LLM_IDLE_MAX_RUNNING_REQUESTS=0
# DASBENCH_LLM_IDLE_MAX_WAITING_REQUESTS=0
# DASBENCH_LLM_IDLE_METRICS_URL=http://localhost:8001/metrics
# DASBENCH_LLM_IDLE_LOCK_PATH=/tmp/dasbench-llm-gate-localhost-8001.lock
# Optional local-model guardrail: retry invalid generated analyze.py/solution.py this many times.
# DASBENCH_CODE_REPAIR_LIMIT=3
# Optional local-model guardrail: retry analyze.py execution failures this many times.
# DASBENCH_ANALYSIS_RETRY_LIMIT=3
# Optional local-model guardrail: retry solution.py after infeasible/error train summaries.
# DASBENCH_SOLUTION_REPAIR_LIMIT=3
# Optional local-model guardrail: fail a generated solver call after this many seconds per instance.
# DASBENCH_SOLVER_TIMEOUT_SECONDS=360
# Optional local-model guardrail: fail a generated solver evaluation above this many MiB.
# DASBENCH_SOLVER_MEMORY_LIMIT_MB=65536
